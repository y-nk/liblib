{
  "name": "liblib-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "start": "pnpm --filter liblib start",
    "android": "pnpm --filter liblib android",
    "ios": "pnpm --filter liblib ios",
    "format": "pnpm --recursive --parallel --if-present format",
    "format:check": "pnpm --recursive --parallel --if-present format:check",
    "lint": "pnpm --recursive --parallel --if-present lint",
    "test": "pnpm --recursive --parallel --if-present test",
    "typecheck": "pnpm --recursive --parallel --if-present typecheck"
  }
}
